---
source: tests/cli.rs
info:
  program: flake-edit
  args:
    - "--flake"
    - "[FIXTURES]/follow_alias_exact_tie.flake.nix"
    - "--lock-file"
    - "[FIXTURES]/follow_alias_exact_tie.flake.lock"
    - "--diff"
    - follow
  env:
    NO_COLOR: "1"
---
success: true
exit_code: 0
